<h1>Editando a tarefa: {{task.title}}</h1>

<form action="/tasks/edit" method="POST">
    <input type="hidden" name="id" value="{{task.id}}">
    <div class="controll">
        <label>Name:</label>
        <input type="text" name="title" placeholder="Insira o título" value="{{task.title}}">
        <label>Description:</label>
        <input type="text" name="description" placeholder="Insira a descrição" value="{{task.description}}">
    </div>

    <div class="form-controll">
        <input type="submit" value="Editar">
    </div>
</form>